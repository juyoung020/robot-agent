{
  "comment": "G3 RL 교사 PPO: G1 CURRICULUM A0 → A1, 지도는 G2 자라는 지도(토큰). 값의 근거는 config/README.md",
  "n_env": 4096,
  "horizon": 64,
  "epochs": 5,
  "minibatches": 4,
  "stage": 0,
  "use_map": 1,
  "adaptive_lr": 1,
  "use_graphs": 1,
  "log_ring": 16,
  "inflight": 3,
  "dw_chunk": 1024,
  "seed": 1,
  "gamma": 0.99,
  "lam": 0.95,
  "clip": 0.2,
  "vclip": 0.2,
  "vf_coef": 0.5,
  "ent_coef": 0.0,
  "lr": 3e-4,
  "lr_min": 1e-5,
  "lr_max": 1e-3,
  "kl_target": 0.01,
  "max_grad_norm": 1.0,
  "adam_b1": 0.9,
  "adam_b2": 0.999,
  "adam_eps": 1e-8,
  "init_logstd": -0.5,
  "reward_scale": 1.0,
  "act_dims": 2,
  "shaping": { "coef": 1.0, "near": 8.0, "aim": 1.0, "zone": 1.0, "v": 4.0, "w": 2.0 },
  "curriculum": { "stages": [0, 1], "promote_success": 0.9, "window": 20, "stop_success": 0.98 },
  "budget_minutes": 30,
  "ckpt_every": 200,
  "print_every": 10,
  "out": "runs/ppo_a0a1"
}
