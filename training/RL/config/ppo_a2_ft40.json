{
  "comment": "A2 교사 미세 조정(충돌 줄이기 빠른 시험): 켬 씨앗 1 체크포인트(--resume)에서 A2C2 단계만 10 분, 충돌 추가 벌 -20 -> -40 (가정)",
  "n_env": 4096,
  "horizon": 64,
  "epochs": 5,
  "minibatches": 4,
  "stage": 0,
  "use_map": 2,
  "adaptive_lr": 1,
  "use_graphs": 1,
  "log_ring": 16,
  "inflight": 3,
  "dw_chunk": 1024,
  "seed": 1,
  "gamma": 0.99,
  "lam": 0.95,
  "clip": 0.2,
  "vclip": 0.2,
  "vf_coef": 0.5,
  "ent_coef": 0.0,
  "lr": 0.0003,
  "lr_min": 1e-05,
  "lr_max": 0.001,
  "kl_target": 0.01,
  "max_grad_norm": 1.0,
  "adam_b1": 0.9,
  "adam_b2": 0.999,
  "adam_eps": 1e-08,
  "init_logstd": -0.5,
  "reward_scale": 1.0,
  "act_dims": 2,
  "shaping": {
    "coef": 1.0,
    "near": 8.0,
    "aim": 1.0,
    "zone": 1.0,
    "v": 4.0,
    "w": 2.0,
    "coll": -40.0
  },
  "curriculum": {
    "stages": [
      {
        "name": "A2C2",
        "env": 2,
        "map": [
          0.1,
          0.1
        ],
        "promote": 2.0,
        "metric": 2
      }
    ],
    "window": 20,
    "stop_success": 2.0
  },
  "budget_minutes": 10,
  "ckpt_every": 200,
  "print_every": 10,
  "out": "runs/ppo_a2_ft40",
  "goal_from_map": 1,
  "bound_coef": 0.5,
  "map_kmin": 3,
  "map_kmax": 6,
  "map_reveal_r": 1.5
}