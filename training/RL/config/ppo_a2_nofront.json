{
  "comment": "ppo_a2 와 같고 안 본 곳 광선만 뺌(use_map 1 = G4 지도 토큰)",
  "n_env": 4096,
  "horizon": 64,
  "epochs": 5,
  "minibatches": 4,
  "stage": 0,
  "use_map": 1,
  "adaptive_lr": 1,
  "use_graphs": 1,
  "log_ring": 16,
  "inflight": 3,
  "dw_chunk": 1024,
  "seed": 1,
  "gamma": 0.99,
  "lam": 0.95,
  "clip": 0.2,
  "vclip": 0.2,
  "vf_coef": 0.5,
  "ent_coef": 0.0,
  "lr": 0.0003,
  "lr_min": 1e-05,
  "lr_max": 0.001,
  "kl_target": 0.01,
  "max_grad_norm": 1.0,
  "adam_b1": 0.9,
  "adam_b2": 0.999,
  "adam_eps": 1e-08,
  "init_logstd": -0.5,
  "reward_scale": 1.0,
  "act_dims": 2,
  "shaping": {
    "coef": 1.0,
    "near": 8.0,
    "aim": 1.0,
    "zone": 1.0,
    "v": 4.0,
    "w": 2.0,
    "coll": -20.0
  },
  "curriculum": {
    "stages": [
      { "name": "A0C0", "env": 0, "map": [1.0, 0.0], "promote": 0.9, "metric": 0 },
      { "name": "A1C0", "env": 1, "map": [1.0, 0.0], "promote": 0.8, "metric": 0 },
      { "name": "A2C0", "env": 2, "map": [1.0, 0.0], "promote": 0.85, "metric": 0 },
      { "name": "A2C1", "env": 2, "map": [0.2, 0.8], "promote": 0.7, "metric": 1 },
      { "name": "A2C2", "env": 2, "map": [0.1, 0.1], "promote": 2.0, "metric": 2 }
    ],
    "window": 20,
    "stop_success": 2.0
  },
  "budget_minutes": 20,
  "ckpt_every": 200,
  "print_every": 10,
  "out": "runs/ppo_a2_nofront",
  "goal_from_map": 1,
  "bound_coef": 0.5,
  "map_kmin": 3,
  "map_kmax": 6,
  "map_reveal_r": 1.5
}