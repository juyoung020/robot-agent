# robot-agent 외부 경로 한 곳. 코드·스크립트는 여기서 정한 환경 변수만 읽는다.
# 쓰는 법:  bash 스크립트 맨 앞에  . "$(dirname "$0")/../config/paths.env"   (깊이에 맞게)
#           파이썬은 config/paths.py 의 paths() 가 이 파일을 읽는다.
# 내 PC 만 다른 값: config/paths.local.env 에 같은 이름으로 적는다(git 에 안 올림). 환경 변수로 미리 정해 두면 그것이 우선.
# 위치 규칙: 큰 것은 전부 저장소 안(build/ models/ data/ third_party/ — 모두 gitignore). conda·venv 는 홈 그대로.
# 형식: 이름=${이름:-기본값} 한 줄씩.

RA_ROOT=${RA_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}
[ -f "$RA_ROOT/config/paths.local.env" ] && . "$RA_ROOT/config/paths.local.env"

# ── 빌드 결과(한 곳). cmake 폴더 = $RA_BUILD/<이름>, 실행 파일 링크 = $RA_BUILD/bin, cargo = $RA_BUILD/cargo/<이름>
RA_BUILD=${RA_BUILD:-$RA_ROOT/build}
RA_CUDA_ROOT=${RA_CUDA_ROOT:-/usr/local/cuda-12.8}
RA_CUDA_ARCH=${RA_CUDA_ARCH:-120}

# ── 큰 외부 데이터(저장소 밖, 지우지 않음)
RA_DATASETS=${RA_DATASETS:-$RA_ROOT/data/datasets}              # 실제 bag·시뮬 스트림·viewcmp 등
RA_MODELS=${RA_MODELS:-$RA_ROOT/models}                 # 가중치·엔진 전부(gitignore)
OVDET_MODELS=${OVDET_MODELS:-$RA_MODELS/ovdet}        # TensorRT 엔진(x86_sm120/…)·ONNX 가중치
RA_EMBED_WORK=${RA_EMBED_WORK:-$RA_ROOT/data/embed_work}        # 임베딩 학습 작업 폴더(labels/·emb/·data/·runs/)
RA_LABELS=${RA_LABELS:-$RA_EMBED_WORK/labels/objects-v1}  # 라벨 표(libsgrt·sgclip 이 읽음; SGRT_LABELS 로도 덮어씀)
RA_TRAINVIEW_WORK=${RA_TRAINVIEW_WORK:-$RA_ROOT/data/trainview_work}  # 학습 뷰어 기록·deps 링크
RA_B1K_SCENES=${RA_B1K_SCENES:-$RA_ROOT/data/b1k_scenes}   # GPU 환경용 BEHAVIOR 장면 묶음(.rasc)
RA_CHECKPOINTS=${RA_CHECKPOINTS:-$RA_ROOT/data/checkpoints}   # 교사·학생 체크포인트(ppo/ …)

# ── BEHAVIOR-1K / OmniGibson (시뮬 장면 원천. 약관상 저장소에 넣지 않음)
B1K_ROOT=${B1K_ROOT:-$RA_ROOT/third_party/BEHAVIOR-1K}   # 데이터 이동 승인 전에는 paths.local.env 에 옛 위치(src/behavior-2026/BEHAVIOR-1K)를 적는다
OG_CONDA_ENV=${OG_CONDA_ENV:-behavior}
OG_PYTHON=${OG_PYTHON:-$HOME/miniconda3/envs/$OG_CONDA_ENV/bin/python}
export RA_MODELS RA_ROOT RA_BUILD RA_CUDA_ROOT RA_CUDA_ARCH RA_DATASETS OVDET_MODELS RA_EMBED_WORK RA_LABELS RA_TRAINVIEW_WORK RA_B1K_SCENES RA_CHECKPOINTS B1K_ROOT OG_CONDA_ENV OG_PYTHON
