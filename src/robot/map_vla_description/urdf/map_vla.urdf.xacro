<?xml version="1.0"?>
<!-- LIMO (mobile base) + OMX-F (arm on top). TF: base_footprint -> base_link -> omx_link0 -> ... -> omx_end_effector_link -->
<robot name="map_vla" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find limo_description)/urdf/limo_four_diff.xacro" />
  <xacro:include filename="$(find open_manipulator_description)/urdf/omx_f/omx_f_arm.urdf.xacro" />

  <!-- arm mount pose in LIMO base_link. OMX base plate is 120 x 150 mm; x=-0.04 is the chosen seat (x in -0.02..0.00 has more clearance but was judged worse by eye) (rear lip at x<-0.08, antennas/front pod at x>0.03). No LIMO screw holes match the OMX 25 mm hole grid, so a real mount needs an adapter plate. -->
  <xacro:property name="arm_x" value="-0.04"/>
  <xacro:property name="arm_y" value="0.0"/>
  <xacro:property name="arm_z" value="0.0"/>
  <xacro:property name="arm_yaw" value="0.0"/>

  <xacro:omx_f prefix="omx_" />

  <!-- ===== Body camera lens (Orbbec Dabai): depth_camera_link is the sensor BODY centre (collision box 0.02 m deep,
       base_link x 0.074..0.094 = the camera panel of the limo_base mesh). The lens / optical centre is on the panel's
       front face: +0.010 m along depth_camera_link x -> base_link (0.094, 0, 0.03). This is where the OmniGibson body
       camera `eyes` sits (src/robot/og/limo_omx_source_config.yaml, robot-agent 391c04b) and what scenemap cam 0 /
       FK tables must use (depth_link stays the upstream body-centre optical frame). -->
  <joint name="depth_camera_lens_joint" type="fixed">
    <parent link="depth_camera_link"/>
    <child link="depth_camera_lens_link"/>
    <origin xyz="0.010 0 0" rpy="0 0 0"/>
  </joint>
  <link name="depth_camera_lens_link"/>
  <!-- optical frame: z forward, x right, y down (REP-103) -->
  <joint name="depth_camera_lens_optical_joint" type="fixed">
    <parent link="depth_camera_lens_link"/>
    <child link="depth_camera_lens_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
  <link name="depth_camera_lens_optical_frame"/>

  <joint name="omx_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="omx_link0"/>
    <origin xyz="${arm_x} ${arm_y} ${arm_z}" rpy="0 0 ${arm_yaw}"/>
  </joint>

  <joint name="omx_end_effector_joint" type="fixed">
    <parent link="omx_link5"/>
    <child link="omx_end_effector_link"/>
    <origin xyz="0.09193 -0.0016 0" rpy="0 0 0"/>
  </joint>
  <link name="omx_end_effector_link"/>
  <!-- ===== Grasp point: where an object actually sits between the closed fingers (E0, robot-agent 66fe1ee,
       docs/map_vla/CURRICULUM_BEHAVIOR2026.md 5.3; src/robot/og/e0/results/verify_eef_kp1e6.json get_eef_in_link5).
       omx_link5 x = 0.08003, i.e. 0.0119 m behind omx_end_effector_link along the finger axis; same as OmniGibson
       get_eef_position(). scenemap's LIMO grasp rule / FK tables (gen_limo_fk_table) use this frame. -->
  <joint name="grasp_point_joint" type="fixed">
    <parent link="omx_link5"/>
    <child link="grasp_point"/>
    <origin xyz="0.08003 -0.0016 0" rpy="0 0 0"/>
  </joint>
  <link name="grasp_point"/>
  <!-- ===== Manipulator wrist camera: the RGB camera already modelled in the OMX-F link5 mesh (no depth) =====
       The OMX-F mesh (follower_06_pan_Revised.stl, link5) contains a camera module. Pose measured from that mesh
       (link5 frame): the lens front is a 14 mm disc centred at (0.0498, 0, 0.0351); the camera plate normal /
       optical axis points forward and 37.94 deg DOWN, yaw 0 (axis = 0.7887, 0, -0.6148).
       No extra camera body is added (an earlier box stacked on this one was wrong).
       Matches ROBOTIS physical_ai_tools topic camera1 (/camera1/image_raw). Intrinsics unknown (640x480 USB cam). -->
  <joint name="wrist_cam_joint" type="fixed">
    <parent link="omx_link5"/>
    <child link="wrist_cam_link"/>
    <origin xyz="0.0498 0 0.0351" rpy="0 0.66212 0"/>
  </joint>
  <link name="wrist_cam_link"/>
  <!-- optical frame: z forward, x right, y down (REP-103) -->
  <joint name="wrist_cam_optical_joint" type="fixed">
    <parent link="wrist_cam_link"/>
    <child link="wrist_cam_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
  <link name="wrist_cam_optical_frame"/>
</robot>
